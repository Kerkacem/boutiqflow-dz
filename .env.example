# ======================================================================
# MAHAL ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Do NOT store actual secrets in this file or commit .env to git!
# ======================================================================

# Database
DATABASE_URL="postgres://mahal_app:change_me_in_prod@localhost:5432/mahal_production"
POSTGRES_PASSWORD="change_me_in_prod"

# Application Security
SESSION_SECRET="change_me_min_32_characters_random_hex"
ENCRYPTION_KEY="change_me_aes256_encryption_key_min_32_chars"

# Domain & Networking
APP_DOMAIN="app.mahal.dz"
PORT=3000

# Courier Gateway Credentials (Encrypted at rest per tenant; sandbox keys for dev)
YALIDINE_API_ID=""
YALIDINE_API_TOKEN=""

# Chargily Pay V2 (Algeria CIB / Edahabia Gateway)
CHARGILY_PUBLIC_KEY=""
CHARGILY_SECRET_KEY=""
CHARGILY_WEBHOOK_SECRET=""
